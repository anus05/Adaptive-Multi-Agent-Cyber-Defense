# .env.example — LLM Integration Configuration Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to source control.

# Required: Your Google AI Studio / Vertex AI API key for Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override the Gemini model name.
# The default in llm_client.py is: gemini-3.6-flash
# This is a preview/enterprise-tier model. Standard API keys may need a different name.
# Common model names:
#   gemini-3.6-flash        (default, preview/enterprise tier)
#   gemini-2.5-flash        (standard API tier)
#   gemini-2.0-flash        (standard API tier)
#   gemini-1.5-flash        (standard API tier, stable)
# If you get a 404, check which models are available for your API key.
GEMINI_MODEL=gemini-3.6-flash
